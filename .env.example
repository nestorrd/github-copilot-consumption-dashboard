# Copy to .env and adjust. All values are optional.

# HTTP server (bound to 127.0.0.1 only)
PORT=3000

# Per-session AI Credit budget. 100 AI Credits = $1.00
# green: below warn ratio, amber: >= warn ratio, red: budget exceeded
SESSION_CREDIT_BUDGET=100
SESSION_CREDIT_WARN_RATIO=0.8

# Where completed session summaries are stored
DATA_FILE=./data/sessions.json

# Conversion of the SDK's nano-AI-unit values to AI Credits.
# Official SDK usage-and-billing examples use / 1e9 but warn that billing is the
# authority. This configurable convention is not a guaranteed SDK exchange rate.
NANO_AIU_PER_AI_CREDIT=1000000000

# Authentication: by default the SDK uses your logged-in GitHub / gh CLI user.
# Set a token only if you want to override that.
# COPILOT_GITHUB_TOKEN=

# Optional default model id for new sessions (must exist in models.list)
# DEFAULT_MODEL=

# Tool permission requests from the agent are REJECTED by default.
# Set to true to auto-approve every tool call (shell, file edits...). Use with care.
COPILOT_APPROVE_ALL_TOOLS=false
